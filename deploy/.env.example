# 复制为 deploy/.env 后按需修改。真实 .env 已被 .gitignore 排除，不要提交。
#
# 这里的默认值全部是「本地能跑起来」取向，不是安全取向：
# 三个密钥类配置在生产必须换成高熵随机串，且只能由密钥管理系统注入。

# ---- PostgreSQL ----
POSTGRES_DB=mcpbridge
POSTGRES_USER=mcpbridge
POSTGRES_PASSWORD=mcpbridge
POSTGRES_PORT=5432

# ---- Manager ----
MANAGER_PORT=8080
# JWT 签名密钥：平台按 SHA-256 派生 HS256 密钥，因此长度不必是 32 字节，但必须够随机
MANAGER_JWT_SECRET=dev-only-jwt-secret-please-change-me
# Auth-B 凭据的字段级加密主密钥（AES-256-GCM）。换密钥会导致已存密文无法解密，上线前先定稿
MANAGER_CRYPTO_KEY=dev-only-crypto-key-please-change-me
MANAGER_ADMIN_PASSWORD=admin123
# SSRF 防护开关：true 允许拉取回环/私有网段里的 Swagger 文档，仅限本地联调
MANAGER_PARSE_ALLOW_PRIVATE_NETWORKS=true

# ---- 集群与节点接入 ----
EXECUTOR_CLUSTER_NAME=default
# 节点接入令牌：Manager 侧只存 sha256，Executor 每次注册/心跳携带
EXECUTOR_BOOTSTRAP_TOKEN=dev-executor-bootstrap-token
# MCP 客户端实际访问的集群入口。生产填负载均衡器地址，本地填宿主回环 + executor-1 端口
EXECUTOR_CLUSTER_ENTRYPOINT=http://localhost:9090

# ---- Executor 端口映射 ----
EXECUTOR_1_PORT=9090
EXECUTOR_2_PORT=9091

# ---- Executor ↔ Redis（应用层共享状态，BR-6）----
# single = 单实例 / 主从 / 代理（默认；编排里自带的 redis 容器属于这一类）
# cluster = Redis Cluster，此时 NODES 必须给全，ADDRESS 不生效（Cluster 只有 db0）
EXECUTOR_REDIS_MODE=single
EXECUTOR_REDIS_ADDRESS=redis://redis:6379
# 逗号分隔的节点地址，可省略 redis:// 前缀；仅 cluster 模式使用
EXECUTOR_REDIS_NODES=

# ---- 控制台 ----
# nginx 同源反代 /api 到 manager:8080，浏览器里永远只访问这一个端口
UI_PORT=5173